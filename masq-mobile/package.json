{
  "name": "MasqMobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "archive:ios": "bash scripts/archive-ios-app-store.sh",
    "build:android:direct": "bash scripts/build-android-direct-release.sh",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:ci:linux": "jest --ci --runInBand --detectOpenHandles --testTimeout=15000 --testPathIgnorePatterns=iosNativeCoreLinking.test.ts",
    "test:ci:ios": "jest --runInBand --runTestsByPath __tests__/iosNativeCoreLinking.test.ts",
    "test:core": "node scripts/test-core.mjs",
    "test:engine": "node scripts/test-engine.mjs",
    "test:tunnel": "rustup run 1.97.1 cargo test --manifest-path native/masq-packet-tunnel/Cargo.toml --locked",
    "native:android": "bash scripts/build-rust-android.sh",
    "native:ios": "PLATFORM_NAME=iphonesimulator ARCHS=arm64 CONFIGURATION_BUILD_DIR=native/build/ios/output bash scripts/build-rust-ios.sh",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:core",
    "verify:ci:linux": "npm run typecheck && npm run lint && npm run test:ci:linux && npm run test:core && npm run test:engine && npm run test:tunnel && npm run verify:privacy",
    "verify:android:apk": "bash scripts/verify-android-apk-privacy.sh",
    "verify:android:native": "node scripts/verify-android-native-elf.js --jni-dir android/app/src/main/jniLibs",
    "verify:android:native:apk": "node scripts/verify-android-native-elf.js --apk android/app/build/outputs/apk/release/app-release-unsigned.apk",
    "verify:privacy": "bash scripts/verify-source-privacy.sh && bash scripts/verify-android-webview-patch.sh",
    "verify:all": "npm run verify && npm run test:engine && npm run test:tunnel && npm run verify:privacy"
  },
  "codegenConfig": {
    "name": "MasqMobileSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.masqmobile"
    },
    "ios": {
      "modulesProvider": {
        "NativeMasqCore": "RCTMasqCore"
      }
    }
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.2",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^8.0.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "patch-package": "^8.0.1",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
