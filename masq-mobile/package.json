{
  "name": "MasqMobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "archive:ios": "bash scripts/archive-ios-app-store.sh",
    "build:android:direct": "bash scripts/build-android-direct-release.sh",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:core": "node scripts/test-core.mjs",
    "test:engine": "node scripts/test-engine.mjs",
    "test:tunnel": "rustup run 1.97.1 cargo test --manifest-path native/masq-packet-tunnel/Cargo.toml --locked",
    "native:android": "bash scripts/build-rust-android.sh",
    "native:ios": "PLATFORM_NAME=iphonesimulator ARCHS=arm64 CONFIGURATION_BUILD_DIR=native/build/ios/output bash scripts/build-rust-ios.sh",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:core",
    "verify:android:apk": "bash scripts/verify-android-apk-privacy.sh",
    "verify:privacy": "bash scripts/verify-source-privacy.sh",
    "verify:all": "npm run verify && npm run test:engine && npm run test:tunnel && npm run verify:privacy"
  },
  "codegenConfig": {
    "name": "MasqMobileSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.masqmobile"
    },
    "ios": {
      "modulesProvider": {
        "NativeMasqCore": "RCTMasqCore"
      }
    }
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.86.1",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
